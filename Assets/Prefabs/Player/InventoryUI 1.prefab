  m_text: "<color=#0000FF>public</color> <color=#0000FF>class</color> <color=#2B91AF>WeaponUpgradeLevel3</color>\r\n<color=#0000FF>{</color>\r\n   
    <color=#0000FF>public</color> <color=#0000FF>int</color> <color=#1E90FF>numberOfHits</color>
    <color=#0000FF>=</color> </color><color=#0000FF>      ;</color>\r\n    <color=#0000FF>public</color>
    <color=#0000FF>String</color> <color=#1E90FF>currentElement</color> <color=#0000FF>=</color>
    <color=#A31515>\"       \"</color><color=#0000FF>;</color>\r\n\r\n    <color=#0000FF>public</color>
    <color=#0000FF>void</color> <color=#2B91AF>chargeWeapon</color><color=#0000FF>()</color>\r\n   
    <color=#0000FF>{</color>\r\n        <color=#0000FF>int</color> <color=#1E90FF>weaponCharge</color>
    <color=#0000FF>=</color> 0<color=#0000FF>;</color>\r\n        <color=#0000FF>for</color>
    <color=#0000FF>(</color><color=#0000FF>int</color> <color=#1E90FF>i</color> <color=#0000FF>=</color>
    0<color=#0000FF>;</color> <color=#1E90FF>i</color> <color=#0000FF><=</color>
    <color=#1E90FF>numberOfHits</color><color=#0000FF>;</color> <color=#1E90FF>i</color><color=#0000FF>++</color><color=#0000FF>)</color>\r\n       
    <color=#0000FF>{</color>\r\n            <color=#1E90FF>weaponCharge</color><color=#0000FF>++</color><color=#0000FF>;</color>\r\n       
    <color=#0000FF>}</color>\r\n\r\n        <color=#2B91AF>SpecialAttack</color><color=#0000FF>(</color><color=#1E90FF>weaponCharge</color><color=#0000FF>,</color>
    <color=#1E90FF>currentElement</color><color=#0000FF>)</color><color=#0000FF>;</color>\r\n   
    <color=#0000FF>}</color>\r\n<color=#0000FF>}</color>"
